<?xml version="1.0" encoding="utf-8"?>
<!--
  Permisos: solo los dos que necesitan los recordatorios (D-015). Ninguno da acceso a red
  ni a datos de otras apps. La tarea verificarPermisos* de app/build.gradle.kts falla si
  aparece cualquier otro en el manifiesto fusionado, en particular INTERNET.

  Respaldo:
  - allowBackup="false" desactiva el respaldo en la nube de Google en todas las versiones.
  - En Android 12+ eso NO impide la transferencia directa entre teléfonos al cambiar de
    equipo; dataExtractionRules la excluye también. Cuando la base esté cifrada con una
    llave del Keystore, copiarla a otro teléfono sería inútil (la llave no viaja), y antes
    de eso sería sacar los datos sin cifrar. La recuperación será el respaldo cifrado propio.
  - fullBackupContent cubre Android 11 y anteriores con la misma regla.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Mostrar los avisos. En Android 13+ el usuario lo concede desde la app. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Volver a programar los avisos después de reiniciar el teléfono. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".FinanzasApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Finanzas"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Alarma del siguiente aviso. Solo la invoca nuestra propia PendingIntent. -->
        <receiver
            android:name=".recordatorios.ReceptorAlarma"
            android:exported="false" />

        <!--
          Eventos del sistema que borran o mueven las alarmas. Todos son "broadcasts
          protegidos" que solo el sistema puede enviar; el receptor además valida la acción.
        -->
        <receiver
            android:name=".recordatorios.ReceptorSistema"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
