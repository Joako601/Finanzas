<?xml version="1.0" encoding="utf-8"?>
<!--
  Capa frontal del ícono adaptable: símbolo geométrico "Flujo" (Fase 2 aprobada).
  Dos arcos paralelos desplazados en diagonal + punto central de balance, con separación
  vertical abierta para que se lea como flujo de entradas/salidas incluso en tamaño pequeño.
  Coordenadas centradas en el cuadro 30..78 dentro de 108x108 (zona segura 66/108).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Arco superior de flujo (entrada) -->
    <path
        android:pathData="M39,55C39,46.7 45.7,40 54,40H68"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="4.4" />

    <!-- Arco inferior de flujo (salida, desplazado para no cerrar como ojo) -->
    <path
        android:pathData="M69,53C69,61.3 62.3,68 54,68H40"
        android:strokeAlpha="0.68"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="4.4" />

    <!-- Punto central de disponible real -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,50.5A3.5,3.5 0 1,0 54,57.5A3.5,3.5 0 1,0 54,50.5Z" />
</vector>
