<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifiesto exclusivo de la distribución nube (D-020).
  - Declara INTERNET solo aquí: la distribución privada nunca ve este archivo.
  - Aplica la política de red (HTTPS en release; HTTP solo a 10.0.2.2 y localhost en debug).
  - Desactiva FirebaseInitProvider porque Firebase se inicializa a mano con FirebaseOptions
    leídas de firebase.properties, sin necesitar google-services.json en el repositorio.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      com.google.android.recaptcha (dependencia transitiva de firebase-auth) agrega
      READ_GSERVICES para leer propiedades heredadas de Google Services Framework.
      No es necesario para correo/contraseña y amplía superficie de privacidad: se retira
      para mantener la lista de permisos de nube estrictamente en INTERNET y ACCESS_NETWORK_STATE.
    -->
    <uses-permission
        android:name="com.google.android.providers.gsf.permission.READ_GSERVICES"
        tools:node="remove" />

    <application
        android:networkSecurityConfig="@xml/network_security_config">

        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />
    </application>

</manifest>
